{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "histor-ui",
      "runtimeExecutable": "uv",
      "runtimeArgs": [
        "run",
        "--directory",
        "projects/histor",
        "--group",
        "ui",
        "-m",
        "histor.ui",
        "--no-browser"
      ],
      "port": 7860
    },
    {
      "name": "histor-dashboard",
      "runtimeExecutable": "uv",
      "runtimeArgs": [
        "run",
        "--directory",
        "projects/histor",
        "--group",
        "server",
        "-m",
        "histor.engine.server",
        "--config",
        "configs/default.yaml"
      ],
      "port": 8000
    },
    {
      "name": "histor-dashboard-laptop",
      "runtimeExecutable": "uv",
      "runtimeArgs": [
        "run",
        "--directory",
        "projects/histor",
        "--group",
        "server",
        "-m",
        "histor.engine.server",
        "--config",
        "configs/laptop.yaml",
        "--port",
        "8001"
      ],
      "port": 8001
    },
    {
      "name": "histor-bench",
      "runtimeExecutable": "uv",
      "runtimeArgs": [
        "run",
        "--directory",
        "projects/histor",
        "--group",
        "ui",
        "-m",
        "histor.engine.app"
      ],
      "port": 7860
    },
    {
      "name": "website",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8080",
        "--directory",
        "../mobius-website/site"
      ],
      "port": 8080
    }
  ]
}
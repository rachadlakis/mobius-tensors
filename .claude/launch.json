{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "argus-ui",
      "runtimeExecutable": "uv",
      "runtimeArgs": ["run", "--directory", "projects/argus", "--group", "ui", "-m", "argus.ui", "--no-browser"],
      "port": 7860
    },
    {
      "name": "argus-dashboard",
      "runtimeExecutable": "uv",
      "runtimeArgs": ["run", "--directory", "projects/argus", "--group", "server", "-m", "argus.engine.server", "--config", "configs/default.yaml"],
      "port": 8000
    },
    {
      "name": "argus-bench",
      "runtimeExecutable": "uv",
      "runtimeArgs": ["run", "--directory", "projects/argus", "--group", "ui", "-m", "argus.engine.app"],
      "port": 7860
    }
  ]
}

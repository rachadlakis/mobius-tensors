# Copy to .env and fill in. .env is git-ignored; this template is not.
# Only the block for the LLM_PROVIDER you pick needs real values.

# ============================================================================
# LLM provider  (every employee routes through LiteLLM - pick ONE provider)
#
# LLM_PROVIDER selects the backend; DEFAULT_MODEL is the model/deployment name
# (a bare name gets the provider prefix; a name with "/" is used as-is).
#
# Split by role to save money: the Chief of Staff does the routing/merging so it
# runs on the capable model; the employees run bounded tasks on a cheaper one.
# Each falls back to DEFAULT_MODEL when unset.
#   ORCHESTRATOR_MODEL - Chief of Staff: routing / delegation / merging  (capable)
#   WORKER_MODEL        - the employees' work                            (cheaper)
# ============================================================================
LLM_PROVIDER=anthropic
DEFAULT_MODEL=claude-haiku-4-5-20251001
# ORCHESTRATOR_MODEL=
# WORKER_MODEL=

# --- anthropic ---
ANTHROPIC_API_KEY=your-anthropic-api-key
# ANTHROPIC_API_BASE=            # optional: point at an Anthropic-compatible gateway

# --- openai ---
# OPENAI_API_KEY=your-openai-api-key

# --- azure (Azure OpenAI: GPT models deployed in an Azure OpenAI resource) ---
# LLM_PROVIDER=azure   DEFAULT_MODEL=<your deployment name>
# AZURE_API_KEY=
# AZURE_API_BASE=https://<your-resource>.openai.azure.com
# AZURE_API_VERSION=2024-10-21

# --- azure_ai (Azure AI Foundry: Llama / Mistral / Phi / DeepSeek / Claude / GPT) ---
# LLM_PROVIDER=azure_ai   DEFAULT_MODEL=<your Foundry DEPLOYMENT name>
# AZURE_AI_API_KEY=
# AZURE_AI_API_BASE=https://<resource>.services.ai.azure.com
# AZURE_AI_API_VERSION=2024-05-01-preview   # only if your endpoint requires it

# --- gemini (Google AI Studio) ---
# LLM_PROVIDER=gemini   DEFAULT_MODEL=gemini-2.0-flash
# GEMINI_API_KEY=

# --- vertex_ai (Google Vertex; Gemini or Claude via Model Garden) ---
# LLM_PROVIDER=vertex_ai   DEFAULT_MODEL=gemini-2.0-flash   (uses gcloud ADC)
# VERTEXAI_PROJECT=
# VERTEXAI_LOCATION=us-central1

# --- bedrock (AWS) ---
# LLM_PROVIDER=bedrock   DEFAULT_MODEL=anthropic.claude-3-5-haiku-20241022-v1:0
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION_NAME=us-east-1

# ============================================================================
# The company Ergon works for: a folder in companies/ (or a path to one).
# "example" is a made-up sample; copy it to start your own.
# ============================================================================
ERGON_COMPANY=example

# User / tenant context (fixed for now; change later for multi-tenant)
USER_ID=demo_user_001
TENANT_ID=demo_tenant_001

# ============================================================================
# Session storage: "memory" (default, lost on restart) or "database"
# ============================================================================
SESSION_BACKEND=memory
# SESSION_DB_URL=sqlite:///./ergon.db
# SESSION_DB_URL=postgresql+asyncpg://user:pass@localhost:5432/ergon

# ============================================================================
# Researcher - web search + page reading (keyless DuckDuckGo, no account)
# Public web only: GET requests, no cookies/logins, robots.txt honoured,
# internal/private addresses refused. Keep SCRAPE_RESPECT_ROBOTS=true.
# ============================================================================
# SEARCH_PROVIDER=duckduckgo
# SEARCH_MAX_RESULTS=5
# SEARCH_REGION=us-en
# SCRAPE_MAX_CHARS=8000
# SCRAPE_TIMEOUT_SECONDS=15
# SCRAPE_MAX_BYTES=5242880
# SCRAPE_MAX_REDIRECTS=5
# SCRAPE_POLITENESS_DELAY_SECONDS=1.0
# SCRAPE_RESPECT_ROBOTS=true
# WEB_INTEL_MAX_FETCHES_PER_TASK=6
# NEWS_DEFAULT_TIMELIMIT=w        # d / w / m / y
# WEATHER_FORECAST_DAYS=7
# WEB_INTEL_USER_AGENT=ErgonResearcher/1.0 (+https://<your-domain>/bot)

# ============================================================================
# Chief of Staff -> employee call resilience (a slow/down employee becomes a
# readable error the Chief of Staff routes around, not a crash).
# ============================================================================
# A2A_CLIENT_TIMEOUT_SECONDS=300      # per-call read timeout
# A2A_HEALTHCHECK_TIMEOUT_SECONDS=5   # agent-card ping before delegating; 0 disables
# A2A_MAX_RETRIES=1                   # retries on transient errors (conn refused, 502/503/504)
# A2A_RETRY_BACKOFF_SECONDS=1.5

# Employee server host/ports
AGENT_HOST=localhost
# Each employee's port is in employees/<id>.yaml; override one with <ID>_PORT:
# RESEARCHER_PORT=10005
# DATA_ANALYST_PORT=10003

# run_python (Data Analyst): time limit per script. A local subprocess for internal
# use, not a security sandbox (see shared/sandbox.py).
# SANDBOX_TIMEOUT_SECONDS=60

# ============================================================================
# Engineer: runs Claude Code (Claude Agent SDK) on a branch of its own in a git
# worktree. Uses ANTHROPIC_API_KEY (or your Claude Code login). Never pushes unless
# ENGINEER_OPEN_PR=true, and then only a draft pull request (needs gh).
# ============================================================================
# Repositories it may work on: name=path, separated by ;
# ERGON_REPOS=website=C:/code/website;app=C:/code/app
# ENGINEER_MODEL=claude-opus-5-5
# ENGINEER_MAX_TURNS=80
# ENGINEER_MAX_BUDGET_USD=5
# ENGINEER_TIMEOUT_SECONDS=1500
# ENGINEER_OPEN_PR=false
